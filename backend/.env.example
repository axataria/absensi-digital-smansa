# Local server
PORT=5000
NODE_ENV=development

# Use the Supabase transaction pooler (port 6543) on Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Browser origin used during local development
FRONTEND_URL=http://localhost:5173

# Production only: set SEED_DATABASE=true for one deployment to create the
# first administrator, then remove it or change it back to false.
SEED_DATABASE=false
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
